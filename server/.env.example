# Compose deployment identity. Use a different name for each independent stack.
COMPOSE_PROJECT_NAME=audioagents-server

# Required public/NAT address for LiveKit RTC and SIP media.
PUBLIC_IP=CHANGE_ME_PUBLIC_IP

# Model credentials. Never commit the populated server/.env file.
DASHSCOPE_API_KEY=CHANGE_ME_DASHSCOPE_API_KEY
DEEPSEEK_API_KEY=CHANGE_ME_DEEPSEEK_API_KEY
HERMES_MODEL=deepseek-v4-pro
HERMES_MODEL_BASE_URL=https://api.deepseek.com/v1

# Generated automatically by scripts/prepare.sh.
POSTGRES_DB=audioagents
POSTGRES_USER=audioagents
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
LIVEKIT_API_KEY=CHANGE_ME_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=CHANGE_ME_LIVEKIT_API_SECRET
MINIO_ROOT_USER=audioagents
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_ROOT_PASSWORD
CLOUD_PARITY_MASTER_KEY=CHANGE_ME_MASTER_KEY
CLOUD_PARITY_DISPATCH_METADATA_KEY=CHANGE_ME_DISPATCH_KEY
CLOUD_PARITY_PHONE_HASH_KEY=CHANGE_ME_PHONE_HASH_KEY
CLOUD_PARITY_METRICS_TOKEN=CHANGE_ME_METRICS_TOKEN

# Existing LiveKit outbound trunk. SIP provider details stay outside the image.
LIVEKIT_SIP_TRUNK_ID=CHANGE_ME_LIVEKIT_SIP_TRUNK_ID
AUDIOAGENT_TRUNK_NAME=primary-outbound
AUDIOAGENT_TRUNK_PROVIDER=external-sip
AUDIOAGENT_SOURCE_NUMBER=
AUDIOAGENT_AGENT_NAME=commercial-agent

# Optional SIP REGISTER keepalive used by providers that require registration.
QWEN_SIP_REGISTER_ENABLED=false
QWEN_SIP_REGISTER_HOST=
QWEN_SIP_REGISTER_PORT=5060
QWEN_SIP_REGISTER_USERNAME=
QWEN_SIP_REGISTER_AUTH_USERNAME=
QWEN_SIP_REGISTER_PASSWORD=
QWEN_SIP_REGISTER_DOMAIN=
QWEN_SIP_REGISTER_CONTACT_HOST=
QWEN_SIP_REGISTER_CONTACT_PORT=5065
QWEN_SIP_REGISTER_EXPIRES=300
QWEN_SIP_DIAL_PREFIX=
QWEN_SIP_STRIP_COUNTRY_CODE=false

# Project is created idempotently on first startup.
AUDIOAGENT_PROJECT_NAME=WeChat AudioAgent
AUDIOAGENT_PROJECT_SLUG=wechat-audioagent
AUDIOAGENT_ADMIN_USER_ID=audioagent-admin
AUDIOAGENT_WORKER_USER_ID=telephony-worker
AUDIOAGENT_MAX_CONCURRENT_CALLS=8
AUDIOAGENT_MAX_CALLS_PER_SECOND=2

# WeChat: run scripts/wechat-login.sh after the stack is healthy.
# "open" accepts every DM; use allowlist and fill user IDs for stricter access.
WEIXIN_DM_POLICY=open
WEIXIN_ALLOWED_USERS=

# Host bindings. Control, LiveKit HTTP and MinIO remain local by default.
CONTROL_BIND_IP=127.0.0.1
CONTROL_PORT=8091
LIVEKIT_HTTP_BIND_IP=127.0.0.1
LIVEKIT_HTTP_PORT=7880
LIVEKIT_TCP_PORT=7881
LIVEKIT_RTC_PORT=7882
SIP_PORT=5065
SIP_RTP_PORT_RANGE=10000-10100
MINIO_BIND_IP=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
RECORDING_PUBLIC_ENDPOINT=http://127.0.0.1:9000
RECORDING_BUCKET=audioagents-recordings
RECORDING_REGION=us-east-1

# Conversation and capacity settings.
QWEN_VOICE_PIPELINE=realtime
DOWNLOAD_LIVEKIT_MODELS=false
# HF_ENDPOINT=https://huggingface.co
QWEN_CUSTOMER_RESPONSE_TIMEOUT_SECONDS=5
QWEN_REALTIME_WECHAT_CLOSE_TIMEOUT_SECONDS=5
QWEN_AMD_ENABLED=true
AUDIOAGENT_CLAIM_BATCH=10
AUDIOAGENT_POLL_SECONDS=1
AUDIOAGENT_RESULT_POLL_SECONDS=2

# Image overrides for an internal registry. Local defaults build AudioAgent.
AUDIOAGENT_IMAGE_PREFIX=audioagents
AUDIOAGENT_IMAGE_TAG=local
# HERMES_IMAGE=nousresearch/hermes-agent@sha256:63003835a35b18ba5fc8fa978e1b3f8a0b7fed3625e845da08cf4a3831000c60
