FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    XDG_CACHE_HOME=/app/qwen-telephony/cache \
    HF_HOME=/app/models/huggingface \
    PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/ \
    PIP_TRUSTED_HOST=mirrors.aliyun.com

WORKDIR /app

COPY qwen-telephony/requirements.lock /app/qwen-telephony/requirements.lock
RUN pip install --no-cache-dir -r /app/qwen-telephony/requirements.lock && pip check

COPY qwen-telephony/agent /app/qwen-telephony/agent
COPY qwen-telephony/config /app/qwen-telephony/config
COPY qwen-telephony/docs/qwen-audio-realtime-dialogue-prompt.md /app/qwen-telephony/docs/qwen-audio-realtime-dialogue-prompt.md

WORKDIR /app/qwen-telephony/agent

RUN addgroup --system telephony \
    && adduser --system --ingroup telephony --home /app/qwen-telephony telephony \
    && mkdir -p /app/qwen-telephony/cache /app/qwen-telephony/logs /app/models \
    && chown -R telephony:telephony /app/qwen-telephony/cache /app/qwen-telephony/logs /app/models

USER telephony

# Classic ASR/TTS deployments should bake Silero and the multilingual text
# turn detector into the image. Realtime + server_vad does not load those
# assets, so restricted-network builds may explicitly skip this optional step.
ARG HF_ENDPOINT=https://huggingface.co
ARG DOWNLOAD_LIVEKIT_MODELS=true
ENV HF_ENDPOINT=${HF_ENDPOINT}
RUN if [ "$DOWNLOAD_LIVEKIT_MODELS" = "true" ]; then \
        python -m livekit.agents download-files; \
    else \
        echo "Skipping optional LiveKit model download for realtime/server_vad"; \
    fi

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import os, urllib.request; port=os.getenv('QWEN_AGENT_PORT', '18081'); urllib.request.urlopen(f'http://127.0.0.1:{port}/worker', timeout=3)" || exit 1

CMD ["python", "phone_agent.py", "start"]
