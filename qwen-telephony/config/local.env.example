LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_HTTP_URL=http://localhost:7880
LIVEKIT_NODE_IP=127.0.0.1

QWEN_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_LLM_BASE_URL=https://llm-vfnjvqxp5829jfc6.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen3.7-flash
QWEN_LLM_WARMUP=true
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_TTS_MODEL=qwen3-tts-flash
QWEN_TTS_VOICE=Cherry
QWEN_TTS_FORMAT=wav
QWEN_ROOM_AUDIO_SAMPLE_RATE=24000
# Voice pipeline macro. "classic" preserves ASR -> ScriptFirstLLM -> TTS;
# "realtime" uses the end-to-end Qwen Audio Realtime model and prompt flow.
QWEN_VOICE_PIPELINE=classic
# QWEN_AUDIO_REALTIME_URL=wss://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime
QWEN_AUDIO_REALTIME_MODEL=qwen-audio-3.0-realtime-flash
QWEN_AUDIO_REALTIME_VOICE=longanqian
# Tuned server VAD reduces false interruption from line echo and short noise.
# smart_turn remains available for semantic end-of-turn comparisons.
QWEN_AUDIO_REALTIME_TURN_DETECTION=server_vad
QWEN_AUDIO_REALTIME_VAD_THRESHOLD=0.65
QWEN_AUDIO_REALTIME_PREFIX_PADDING_MS=200
QWEN_AUDIO_REALTIME_SILENCE_DURATION_MS=650
QWEN_AUDIO_REALTIME_PLAYOUT_TAIL_MS=400
QWEN_REALTIME_WECHAT_CLOSE_TIMEOUT_SECONDS=3
QWEN_REALTIME_SCENE_CACHE_TTL_SECONDS=30
# Optional runtime overrides. The default file contains the local dialogue flow.
# QWEN_AUDIO_REALTIME_PROMPT_FILE=/absolute/path/to/prompt.md
# QWEN_AUDIO_REALTIME_INSTRUCTIONS=完整的单行或多行系统指令
QWEN_REALTIME_SILENCE_MS=200
QWEN_REALTIME_PREFIX_MS=100
# Local/open-model voice activity and text end-of-turn detection. Run
# `python -m livekit.agents download-files` before starting the Agent. Do not
# set LIVEKIT_REMOTE_EOT_URL: the Agent intentionally rejects remote EOT.
QWEN_USE_REALTIME_ASR=true
QWEN_TURN_DETECTION_MODE=multilingual
QWEN_VAD_SAMPLE_RATE=8000
QWEN_VAD_MIN_SPEECH_SECONDS=0.05
QWEN_VAD_MIN_SILENCE_SECONDS=0.55
QWEN_VAD_PREFIX_PADDING_SECONDS=0.2
QWEN_VAD_ACTIVATION_THRESHOLD=0.45
QWEN_ENDPOINTING_MODE=dynamic
QWEN_ENDPOINTING_MIN_DELAY=0.5
QWEN_ENDPOINTING_MAX_DELAY=3.0
QWEN_ENDPOINTING_ALPHA=0.9
# Optional expert override; empty uses the model's per-language thresholds.
# QWEN_TURN_DETECTOR_THRESHOLD=
QWEN_AGENT_ROOM=qwen-phone-room
QWEN_AGENT_NAME=qwen-phone-agent
# Commercial answering-machine detection. Categories and dispositions are
# persisted on managed calls; voicemail messages are optional and must be
# approved for the jurisdictions where they are used.
QWEN_AMD_ENABLED=true
QWEN_AMD_IVR_DETECTION=true
QWEN_AMD_WAIT_UNTIL_FINISHED=true
# QWEN_AMD_VOICEMAIL_MESSAGE=您好，这里是智能语音服务，请方便时回电，谢谢。

# Required when a project's telephony policy uses recording_mode=always.
# The Agent starts an audio-only dual-channel LiveKit Egress after speaking the
# configured disclosure. Prefer workload identity instead of static S3 keys.
# QWEN_RECORDING_S3_BUCKET=replace-with-recording-bucket
# QWEN_RECORDING_S3_REGION=ap-southeast-1
# QWEN_RECORDING_S3_PREFIX=telephony-recordings
# QWEN_RECORDING_S3_ENDPOINT=
# Optional browser-facing endpoint when Egress uses a Docker-internal endpoint.
# QWEN_RECORDING_S3_PUBLIC_ENDPOINT=
# QWEN_RECORDING_S3_FORCE_PATH_STYLE=false
# QWEN_RECORDING_S3_ACCESS_KEY=
# QWEN_RECORDING_S3_SECRET=
# QWEN_RECORDING_S3_SESSION_TOKEN=

SIP_PORT=5065
SIP_RTP_PORT_RANGE=10000-10100
SIP_INBOUND_NUMBER=1000
SIP_TRUNK_NAME=microsip-local-inbound
SIP_DISPATCH_RULE_NAME=microsip-to-qwen-agent

# Optional path override for the original single-node operations workbench.
# Production keeps this legacy surface disabled; the override is useful for
# isolated local tests and disposable development databases.
# QWEN_TELEPHONY_OPS_DATABASE_PATH=/tmp/qwen-telephony-ops.sqlite3

# Cloud-Parity control plane. Development defaults to SQLite when the URL is
# empty. Staging/production require PostgreSQL; production also requires a
# Fernet CLOUD_PARITY_MASTER_KEY supplied by KMS/Vault.
CLOUD_PARITY_ENV=development
# The original single-node SQLite operations UI is disabled by default outside
# development. Production uses the tenant-aware Cloud-Parity APIs and console.
CLOUD_PARITY_ENABLE_LEGACY_SQLITE=true
# Separate Fernet key encrypting sensitive LiveKit dispatch metadata. Phone
# fields use CLOUD_PARITY_MASTER_KEY; configure both distinct keys in production.
# CLOUD_PARITY_DISPATCH_METADATA_KEY=replace-with-a-different-Fernet-key
# Dedicated HMAC key for privacy-preserving consent/DNC number indexes. A
# different random value of at least 32 characters is mandatory in production.
# CLOUD_PARITY_PHONE_HASH_KEY=replace-with-32-or-more-random-characters
# Bearer token protecting the Prometheus /metrics endpoint. Required in production.
# CLOUD_PARITY_METRICS_TOKEN=replace-with-32-or-more-random-characters
# Distributed fixed-window API limit backed by the control-plane database.
# Set to 0 only for local/test use; production refuses to start when disabled.
CLOUD_PARITY_API_REQUESTS_PER_MINUTE=600
CLOUD_PARITY_WEBHOOK_REQUESTS_PER_MINUTE=6000
CLOUD_PARITY_EMBED_TOKENS_PER_MINUTE=60
# CLOUD_PARITY_DATABASE_URL=postgresql://cloud_parity:change-me@127.0.0.1:5432/cloud_parity
CLOUD_PARITY_DB_POOL_MIN_SIZE=1
CLOUD_PARITY_DB_POOL_MAX_SIZE=10
CLOUD_PARITY_DB_POOL_TIMEOUT_SECONDS=10
CLOUD_PARITY_DB_CONNECT_TIMEOUT_SECONDS=10

# Exact browser origins only; wildcard origins are rejected. Same-origin
# staging/production deployments can leave this empty.
CLOUD_PARITY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://127.0.0.1:5174

# Authentication defaults to the legacy X-User-ID header only in development.
# Staging/production must select oidc or trusted-proxy.
CLOUD_PARITY_AUTH_MODE=development
# CLOUD_PARITY_OIDC_ISSUER=https://identity.example.com/
# CLOUD_PARITY_OIDC_AUDIENCE=https://cloud-parity-api.example.com
# CLOUD_PARITY_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# CLOUD_PARITY_OIDC_ALGORITHMS=RS256
# CLOUD_PARITY_OIDC_SUBJECT_CLAIM=sub
# CLOUD_PARITY_OIDC_LEEWAY_SECONDS=30
# CLOUD_PARITY_OIDC_JWKS_CACHE_SECONDS=300
# CLOUD_PARITY_OIDC_JWKS_TIMEOUT_SECONDS=5
# CLOUD_PARITY_TRUSTED_PROXY_USER_HEADER=X-Authenticated-User
# CLOUD_PARITY_TRUSTED_PROXY_SECRET_HEADER=X-Cloud-Parity-Proxy-Secret
# CLOUD_PARITY_TRUSTED_PROXY_SECRET=replace-with-32-or-more-random-characters

# Commercial telephony dispatcher. The service identity must be a project
# member with telephony.operate. Prefer an OIDC client-credentials access token
# in staging/production; X-User-ID is only for local development.
# CLOUD_PARITY_CONTROL_URL=http://127.0.0.1:8091
# CLOUD_PARITY_TELEPHONY_PROJECT_IDS=project-uuid-1,project-uuid-2
# CLOUD_PARITY_SERVICE_BEARER_TOKEN=replace-with-short-lived-service-token
# Rotatable file-mounted token takes precedence over the static value.
# CLOUD_PARITY_SERVICE_BEARER_TOKEN_FILE=/run/secrets/cloud-parity-service-token
# Optional separate credential for the internal dialogue API. When omitted,
# the telephony service credential above is reused.
# QWEN_DIALOGUE_URL=http://127.0.0.1:8091/api/dialogue/turn
# QWEN_DIALOGUE_TIMEOUT=2.0
# QWEN_DIALOGUE_SERVICE_BEARER_TOKEN=replace-with-short-lived-service-token
# QWEN_DIALOGUE_SERVICE_BEARER_TOKEN_FILE=/run/secrets/dialogue-service-token
# CLOUD_PARITY_SERVICE_USER_ID=telephony-worker
# CLOUD_PARITY_TELEPHONY_WORKER_ID=dispatcher-node-1
# CLOUD_PARITY_TELEPHONY_CLAIM_BATCH=10
# CLOUD_PARITY_TELEPHONY_PROJECT_CONCURRENCY=8
# CLOUD_PARITY_TELEPHONY_POLL_SECONDS=1
# CLOUD_PARITY_BUILD_DRIVER=docker
# CLOUD_PARITY_RUNTIME_DRIVER=control-plane
# CLOUD_PARITY_TELEPHONY_HEARTBEAT_SECONDS=10
# Bound unanswered ringing and total call duration so abandoned provider calls
# cannot consume capacity indefinitely. Values are clamped to safe ranges.
# CLOUD_PARITY_TELEPHONY_RINGING_TIMEOUT_SECONDS=45
# CLOUD_PARITY_TELEPHONY_MAX_CALL_DURATION_SECONDS=1800
# Minimum observation period before a missing SIP participant is treated as a
# finished/failed call. Control-plane query failures never trigger a redial.
# CLOUD_PARITY_TELEPHONY_RECONCILIATION_GRACE_SECONDS=120
# Set port to 0 to disable. Production probes should use /live and /ready;
# Prometheus may scrape /metrics on this dedicated internal port.
# CLOUD_PARITY_TELEPHONY_HEALTH_HOST=0.0.0.0
# CLOUD_PARITY_TELEPHONY_HEALTH_PORT=9091
# CLOUD_PARITY_CONTROL_TIMEOUT_SECONDS=5
# CLOUD_PARITY_CONSOLE_POLL_SECONDS=1
# Uvicorn only honors forwarded client addresses from these exact trusted
# proxy IPs/CIDRs. Never use '*' in production.
# FORWARDED_ALLOW_IPS=127.0.0.1
