# Local hybrid-development configuration. Copy this file to dev.env.
# Values in dev.env are not committed.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_NODE_IP=127.0.0.1

SIP_PORT=5066
SIP_RTP_PORT_RANGE=10000-10100
DEV_SIP_ADVERTISED_IP=127.0.0.1

DEV_POSTGRES_DB=cloud_parity
DEV_POSTGRES_USER=cloud_parity
DEV_POSTGRES_PASSWORD=cloud-parity-dev-only
DEV_POSTGRES_PORT=5432
CLOUD_PARITY_DATABASE_URL=postgresql://cloud_parity:cloud-parity-dev-only@127.0.0.1:5432/cloud_parity
CLOUD_PARITY_ENV=development
CLOUD_PARITY_AUTH_MODE=development
CLOUD_PARITY_ENABLE_LEGACY_SQLITE=false
CLOUD_PARITY_BUILD_DRIVER=disabled
CLOUD_PARITY_RUNTIME_DRIVER=control-plane
CLOUD_PARITY_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

CLOUD_PARITY_CONTROL_URL=http://127.0.0.1:8091
CLOUD_PARITY_SERVICE_USER_ID=telephony-worker
CLOUD_PARITY_TELEPHONY_CLAIM_BATCH=2
CLOUD_PARITY_TELEPHONY_PROJECT_CONCURRENCY=2
CLOUD_PARITY_TELEPHONY_POLL_SECONDS=0.5
CLOUD_PARITY_TELEPHONY_HEALTH_PORT=9091
# Required before starting the dispatcher:
# CLOUD_PARITY_TELEPHONY_PROJECT_IDS=replace-with-project-uuid

LIVEKIT_AGENT_NAME=commercial-agent
QWEN_AGENT_EXPLICIT_NAME=commercial-agent
QWEN_AUDIO_REALTIME_TURN_DETECTION=server_vad
QWEN_AUDIO_REALTIME_VAD_THRESHOLD=0.65
QWEN_AUDIO_REALTIME_PREFIX_PADDING_MS=200
QWEN_AUDIO_REALTIME_SILENCE_DURATION_MS=650
QWEN_AUDIO_REALTIME_PLAYOUT_TAIL_MS=400
QWEN_AGENT_PORT=18081
QWEN_AMD_ENABLED=true
QWEN_GREETING_TEXT=您好，我是智能语音助手，很高兴为您服务。请问有什么可以帮助您？
QWEN_LLM_BASE_URL=https://llm-vfnjvqxp5829jfc6.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_LLM_MODEL=qwen3.7-flash
QWEN_LLM_WARMUP=true
DEV_MINIO_ROOT_USER=audioagents
DEV_MINIO_ROOT_PASSWORD=replace-with-a-random-local-password
DEV_MINIO_API_PORT=9000
DEV_MINIO_CONSOLE_PORT=9001
DEV_EGRESS_HEALTH_PORT=8082
QWEN_RECORDING_S3_BUCKET=audioagents-recordings
QWEN_RECORDING_S3_REGION=us-east-1
QWEN_RECORDING_S3_PREFIX=telephony-recordings
# Egress and MinIO share the Compose network, so use the service DNS name.
QWEN_RECORDING_S3_ENDPOINT=http://minio:9000
QWEN_RECORDING_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
QWEN_RECORDING_S3_FORCE_PATH_STYLE=true
QWEN_RECORDING_S3_ACCESS_KEY=audioagents
QWEN_RECORDING_S3_SECRET=replace-with-the-same-random-local-password
# Optional carrier access prefix. It is prepended only to the SIP Request-URI;
# contacts remain stored as E.164 numbers.
QWEN_SIP_DIAL_PREFIX=
# Optional country code removed after stripping the E.164 leading plus.
# Some domestic carriers expect access-prefix + national number.
QWEN_SIP_STRIP_COUNTRY_CODE=

# Keep the actual key in the repository-root .env, never in this file.
# DASHSCOPE_API_KEY=replace-me
